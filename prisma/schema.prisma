generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Quote {
  id         String   @id
  quote      String
  context    String
  authorId   String
  topicId    String
  subtopicId String   @default("tbd")
  status     QuoteStatus @default(draft)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum AuthorStatus {
  research
  complete
}

enum QuoteStatus {
  draft
  approved
  delivered
}

model Author {
  id        String       @id
  name      String
  birthDate DateTime
  deathDate DateTime?
  biography String
  status    AuthorStatus @default(research)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Topic {
  id        String   @id
  name      String
  subtopics String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subtopic {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
